[Unit]
Description=Verify encrypted MT Presence offsite backups

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/mt-presence-offsite/verify_offsite_ciphertexts.sh /srv/mt-presence-backup
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/mt-presence-backup
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE
