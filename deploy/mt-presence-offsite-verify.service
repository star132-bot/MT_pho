[Unit]
Description=Verify encrypted MT Presence offsite backups
OnFailure=mt-presence-offsite-alert@%n.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/mt-presence-offsite/verify_offsite_ciphertexts.sh /srv/mt-presence-backup
UMask=0077
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/mt-presence-backup
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=
