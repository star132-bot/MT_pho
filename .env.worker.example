# Scanner-only Supabase credentials. Never source this file into the web server.
SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer a current sb_secret_ key. Keep real values only in the ignored
# .env.worker file and in the scanner process secret store.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Legacy fallback when a current secret key is not available.
# SUPABASE_SERVICE_ROLE_KEY=replace_with_legacy_service_role_key

# ClamAV must be installed, running, and supplied with current signatures.
MT_SCANNER_ID=00000000-0000-4000-8000-000000000001
MT_SCANNER_CLAMAV_COMMAND='clamdscan --fdpass --no-summary'
MT_SCANNER_POLL_SECONDS=5
MT_SCANNER_LEASE_SECONDS=300
MT_SCANNER_RETRY_SECONDS=30
MT_SCANNER_REQUEST_TIMEOUT_SECONDS=30
MT_SCANNER_DOWNLOAD_TIMEOUT_SECONDS=60
MT_SCANNER_SCAN_TIMEOUT_SECONDS=60
MT_SCANNER_DECODE_TIMEOUT_SECONDS=30
MT_SCANNER_DECODE_MEMORY_BYTES=1073741824
MT_SCANNER_MAX_DOWNLOAD_BYTES=52428800
MT_SCANNER_MAX_IMAGE_PIXELS=80000000
MT_SCANNER_MAX_EDGE=20000

# Optional private temp root. The worker creates a 0700 per-ID subdirectory
# and removes abandoned mt-scan files there before accepting new work.
# MT_SCANNER_TEMP_DIR=/var/lib/mt-presence/scanner-tmp
