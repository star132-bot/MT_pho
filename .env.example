# Supabase project settings. Never commit service-role keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Use 0 only for local HTTP development. Production must use 1 behind HTTPS.
MT_COOKIE_SECURE=0

# Canonical application URL used in verification and password-recovery emails.
# Add the exact callback URLs to the Supabase Auth redirect allowlist.
MT_PUBLIC_BASE_URL=http://127.0.0.1:8131

# PostgreSQL connection values for scripts/deploy_supabase_phase1.sh.
# Keep these in the environment; the script does not pass a password in argv.
PGHOST=db.your-project-ref.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=replace_with_development_database_password
MT_DEPLOY_ENVIRONMENT=development
# Keep yes for a fresh database. Set no after the Phase 0/1 baseline exists.
MT_APPLY_PHASE1_BASELINE=yes

# Two disposable, verified development users for non-mutating RLS testing.
MT_TEST_USER_A_EMAIL=user-a@example.test
MT_TEST_USER_A_PASSWORD=replace_me
MT_TEST_USER_B_EMAIL=user-b@example.test
MT_TEST_USER_B_PASSWORD=replace_me

# Persistent development Admin provisioned by scripts/provision_development_admin.py.
# Keep real values only in the gitignored .env file.
MT_DEV_ADMIN_EMAIL=development-admin@example.test
MT_DEV_ADMIN_PASSWORD=replace_with_generated_local_secret
